# Copie para .env.local (ou .env) e preencha com a URL do seu Realtime Database
# (Firebase console > Build > Realtime Database, aparece no topo da aba "Dados").
# Em produção, cadastre a mesma variável no painel da hospedagem (ex.: Vercel).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
